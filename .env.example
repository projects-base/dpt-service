# Copy to .env (gitignored) and fill in, or set these in your shell / Render dashboard.

# --- Database (Supabase or any PostgreSQL) ---
#
# Port 6543 is Supabase's TRANSACTION-mode pooler. Server-side prepared
# statements are disabled for it in application.yml (prepareThreshold=0);
# without that you get intermittent "prepared statement already exists"
# errors that look like random outages.
#
# Port 5432 is the direct connection: fine too, but it has a much lower
# connection limit and needs IPv6 on some networks.
DATABASE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USERNAME=postgres.your_project_ref
DATABASE_PASSWORD=your_database_password

# --- Google OAuth ---
# Must match the client_id in the extension manifest and the web dashboard.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- Gemini (optional server-side fallback; users can bring their own key) ---
GEMINI_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:*,chrome-extension://*,https://*.netlify.app
