# Copy to .env (gitignored) and fill in, or set these in your shell / Render dashboard.

# --- Database (Neon, or any PostgreSQL) ---
#
# Neon gives you a connection string like:
#   postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# Convert it for JDBC: swap the scheme for jdbc:postgresql:// and move the
# credentials out of the URL into the two variables below.
#
# Prefer the POOLED endpoint (the hostname with the "-pooler" suffix). It is
# PgBouncer in transaction mode, so application.yml disables server-side
# prepared statements (prepareThreshold=0) — without that you get intermittent
# "prepared statement already exists" errors that look like random outages.
#
# sslmode=require is mandatory; Neon refuses plaintext connections.
DATABASE_URL=jdbc:postgresql://ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_password

# --- Google OAuth ---
# Must match the client_id in the extension manifest and the web dashboard.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- Gemini (optional server-side fallback; users can bring their own key) ---
GEMINI_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:*,chrome-extension://*,https://*.netlify.app

# --- Gemini model (optional; a name your key cannot use returns 404) ---
GEMINI_MODEL=gemini-2.5-flash
