</svg>
<figcaption>The bucket shape is the collector's job, not yours. Nesting <code>groupingBy</code> inside <code>groupingBy</code> gives you a two-level map.</figcaption>
</figure>
<div class="hl"><pre><span></span><code><span class="c1">// count per department</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">Long</span><span class="o">&gt;</span><span class="w"> </span><span class="n">headcount</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">counting</span><span class="p">()));</span>

<span class="c1">// highest paid per department  →  Optional, because a group could be empty in theory</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">Optional</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">topPaid</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">maxBy</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">))));</span>

<span class="c1">// unwrap the Optional with collectingAndThen</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">Employee</span><span class="o">&gt;</span><span class="w"> </span><span class="n">topPaidClean</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span>
<span class="w">        </span><span class="n">collectingAndThen</span><span class="p">(</span><span class="n">maxBy</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">)),</span><span class="w"> </span><span class="n">Optional</span><span class="p">::</span><span class="n">get</span><span class="p">)));</span>

<span class="c1">// names only, not whole objects</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">List</span><span class="o">&lt;</span><span class="n">String</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">namesByDept</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">mapping</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">toList</span><span class="p">())));</span>

<span class="c1">// two levels: dept → grade → employees</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">Map</span><span class="o">&lt;</span><span class="n">Grade</span><span class="p">,</span><span class="w"> </span><span class="n">List</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;&gt;&gt;</span><span class="w"> </span><span class="n">nested</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">grade</span><span class="p">)));</span>

<span class="c1">// sorted keys, and a Set per bucket</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">Set</span><span class="o">&lt;</span><span class="n">String</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">sortedDistinct</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">TreeMap</span><span class="p">::</span><span class="k">new</span><span class="p">,</span>
<span class="w">                                     </span><span class="n">mapping</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">toSet</span><span class="p">())));</span>
</code></pre></div>
<h3 id="p8-5-3-partitioningby-exactly-two-buckets-always">5.3 partitioningBy — exactly two buckets, always<a aria-label="Link to this section" class="anchor" href="#p8-5-3-partitioningby-exactly-two-buckets-always">#</a></h3>
