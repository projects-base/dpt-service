<h2 id="p8-6-one-dataset-every-collector">6. One dataset, every collector<a aria-label="Link to this section" class="anchor" href="#p8-6-one-dataset-every-collector">#</a></h2>
<p>Keep this in your head — it answers most "write a stream that…" questions.</p>
<div class="hl"><pre><span></span><code><span class="kd">record</span> <span class="nc">Employee</span><span class="p">(</span><span class="n">String</span><span class="w"> </span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">String</span><span class="w"> </span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">Grade</span><span class="w"> </span><span class="n">grade</span><span class="p">,</span><span class="w"> </span><span class="n">BigDecimal</span><span class="w"> </span><span class="n">salary</span><span class="p">,</span><span class="w"> </span><span class="kt">int</span><span class="w"> </span><span class="n">age</span><span class="p">)</span><span class="w"> </span><span class="p">{}</span>

<span class="n">List</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;</span><span class="w"> </span><span class="n">emps</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">List</span><span class="p">.</span><span class="na">of</span><span class="p">(</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Ana"</span><span class="p">,</span><span class="w">  </span><span class="s">"ENG"</span><span class="p">,</span><span class="w">   </span><span class="n">SENIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="mi">120_000</span><span class="p">),</span><span class="w"> </span><span class="mi">34</span><span class="p">),</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Ben"</span><span class="p">,</span><span class="w">  </span><span class="s">"SALES"</span><span class="p">,</span><span class="w"> </span><span class="n">JUNIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="w"> </span><span class="mi">60_000</span><span class="p">),</span><span class="w"> </span><span class="mi">26</span><span class="p">),</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Cara"</span><span class="p">,</span><span class="w"> </span><span class="s">"ENG"</span><span class="p">,</span><span class="w">   </span><span class="n">JUNIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="w"> </span><span class="mi">90_000</span><span class="p">),</span><span class="w"> </span><span class="mi">29</span><span class="p">),</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Dev"</span><span class="p">,</span><span class="w">  </span><span class="s">"HR"</span><span class="p">,</span><span class="w">    </span><span class="n">SENIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="w"> </span><span class="mi">75_000</span><span class="p">),</span><span class="w"> </span><span class="mi">41</span><span class="p">),</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Eli"</span><span class="p">,</span><span class="w">  </span><span class="s">"SALES"</span><span class="p">,</span><span class="w"> </span><span class="n">SENIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="w"> </span><span class="mi">95_000</span><span class="p">),</span><span class="w"> </span><span class="mi">38</span><span class="p">),</span>
<span class="w">    </span><span class="k">new</span><span class="w"> </span><span class="n">Employee</span><span class="p">(</span><span class="s">"Fay"</span><span class="p">,</span><span class="w">  </span><span class="s">"ENG"</span><span class="p">,</span><span class="w">   </span><span class="n">SENIOR</span><span class="p">,</span><span class="w"> </span><span class="n">bd</span><span class="p">(</span><span class="mi">130_000</span><span class="p">),</span><span class="w"> </span><span class="mi">45</span><span class="p">));</span>
</code></pre></div>
<div class="hl"><pre><span></span><code><span class="c1">// count per dept                  → {ENG=3, HR=1, SALES=2}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">counting</span><span class="p">())</span>

<span class="c1">// names per dept                  → {ENG=[Ana, Cara, Fay], HR=[Dev], SALES=[Ben, Eli]}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">mapping</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">toList</span><span class="p">()))</span>

<span class="c1">// highest paid per dept           → {ENG=Fay, HR=Dev, SALES=Eli}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">collectingAndThen</span><span class="p">(</span>
<span class="w">    </span><span class="n">maxBy</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">)),</span><span class="w"> </span><span class="n">o</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">o</span><span class="p">.</span><span class="na">get</span><span class="p">().</span><span class="na">name</span><span class="p">()))</span>

<span class="c1">// total salary per dept           → {ENG=340000, HR=75000, SALES=155000}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">reducing</span><span class="p">(</span><span class="n">BigDecimal</span><span class="p">.</span><span class="na">ZERO</span><span class="p">,</span><span class="w"> </span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">,</span><span class="w"> </span><span class="n">BigDecimal</span><span class="p">::</span><span class="n">add</span><span class="p">))</span>

<span class="c1">// average age per dept            → {ENG=36.0, HR=41.0, SALES=32.0}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">averagingInt</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">age</span><span class="p">))</span>

<span class="c1">// split by seniority              → {false=[Ben, Cara], true=[Ana, Dev, Eli, Fay]}</span>
<span class="n">partitioningBy</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">grade</span><span class="p">()</span><span class="w"> </span><span class="o">==</span><span class="w"> </span><span class="n">SENIOR</span><span class="p">)</span>

<span class="c1">// dept → grade → names            → {ENG={JUNIOR=[Cara], SENIOR=[Ana, Fay]}, …}</span>
<span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span><span class="w"> </span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">grade</span><span class="p">,</span>
<span class="w">    </span><span class="n">mapping</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">toList</span><span class="p">())))</span>

<span class="c1">// id lookup, first wins on clash  → {Ana=120000, Ben=60000, …}</span>
<span class="n">toMap</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">name</span><span class="p">,</span><span class="w"> </span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">,</span><span class="w"> </span><span class="p">(</span><span class="n">a</span><span class="p">,</span><span class="w"> </span><span class="n">b</span><span class="p">)</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">a</span><span class="p">,</span><span class="w"> </span><span class="n">LinkedHashMap</span><span class="p">::</span><span class="k">new</span><span class="p">)</span>

<span class="c1">// distinct departments, sorted    → [ENG, HR, SALES]</span>
<span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">map</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">).</span><span class="na">distinct</span><span class="p">().</span><span class="na">sorted</span><span class="p">().</span><span class="na">toList</span><span class="p">()</span>

<span class="c1">// one-line report                 → "Fay(130000), Ana(120000), Eli(95000)"</span>
<span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">sorted</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">).</span><span class="na">reversed</span><span class="p">()).</span><span class="na">limit</span><span class="p">(</span><span class="mi">3</span><span class="p">)</span>
<span class="w">    </span><span class="p">.</span><span class="na">map</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">name</span><span class="p">()</span><span class="w"> </span><span class="o">+</span><span class="w"> </span><span class="s">"("</span><span class="w"> </span><span class="o">+</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">salary</span><span class="p">()</span><span class="w"> </span><span class="o">+</span><span class="w"> </span><span class="s">")"</span><span class="p">).</span><span class="na">collect</span><span class="p">(</span><span class="n">joining</span><span class="p">(</span><span class="s">", "</span><span class="p">))</span>

<span class="c1">// age stats in one pass           → count=6, min=26, max=45, avg=35.5</span>
<span class="n">summarizingInt</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">age</span><span class="p">)</span>

<span class="c1">// second highest salary</span>
<span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">map</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">).</span><span class="na">distinct</span><span class="p">()</span>
<span class="w">    </span><span class="p">.</span><span class="na">sorted</span><span class="p">(</span><span class="n">reverseOrder</span><span class="p">()).</span><span class="na">skip</span><span class="p">(</span><span class="mi">1</span><span class="p">).</span><span class="na">findFirst</span><span class="p">()</span>
</code></pre></div>
