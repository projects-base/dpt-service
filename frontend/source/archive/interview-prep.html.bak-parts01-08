</g>
<text class="m" x="262" y="30">counting()</text>
<text class="m" x="262" y="66">summingDouble(salary)</text>
<text class="m" x="262" y="102">averagingDouble(salary)</text>
<text class="m" x="262" y="138">maxBy(comparing(salary))</text>
<text class="m" x="262" y="174">mapping(name, toList())</text>
<g class="leaf">
<rect height="30" rx="3" width="226" x="480" y="10"></rect>
<rect height="30" rx="3" width="226" x="480" y="46"></rect>
<rect height="30" rx="3" width="226" x="480" y="82"></rect>
<rect height="30" rx="3" width="226" x="480" y="118"></rect>
<rect height="30" rx="3" width="226" x="480" y="154"></rect>
</g>
<text class="m" x="492" y="30">{ENG=3, SALES=2, HR=1}</text>
<text class="m" x="492" y="66">{ENG=310000.0, …}</text>
<text class="m" x="492" y="102">{ENG=103333.3, …}</text>
