<div class="hl"><pre><span></span><code><span class="n">Map</span><span class="o">&lt;</span><span class="n">Boolean</span><span class="p">,</span><span class="w"> </span><span class="n">List</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">split</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">partitioningBy</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">salary</span><span class="p">().</span><span class="na">compareTo</span><span class="p">(</span><span class="n">HIGH</span><span class="p">)</span><span class="w"> </span><span class="o">&gt;</span><span class="w"> </span><span class="mi">0</span><span class="p">));</span>

<span class="n">split</span><span class="p">.</span><span class="na">get</span><span class="p">(</span><span class="kc">true</span><span class="p">);</span><span class="w">   </span><span class="c1">// never null</span>
<span class="n">split</span><span class="p">.</span><span class="na">get</span><span class="p">(</span><span class="kc">false</span><span class="p">);</span><span class="w">  </span><span class="c1">// never null — this is the whole point</span>

<span class="c1">// with a downstream, same as groupingBy</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">Boolean</span><span class="p">,</span><span class="w"> </span><span class="n">Long</span><span class="o">&gt;</span><span class="w"> </span><span class="n">counts</span><span class="w"> </span><span class="o">=</span>
<span class="w">    </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">partitioningBy</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">active</span><span class="p">(),</span><span class="w"> </span><span class="n">counting</span><span class="p">()));</span>
</code></pre></div>
<h3 id="p8-5-4-the-rest-of-the-catalogue">5.4 The rest of the catalogue<a aria-label="Link to this section" class="anchor" href="#p8-5-4-the-rest-of-the-catalogue">#</a></h3>
<table>
<thead>
<tr>
<th>Collector</th>
<th>Produces</th>
<th>Note</th>
</tr>
</thead>
<tbody>
<tr>
<td><code>toList()</code> / <code>toUnmodifiableList()</code></td>
<td><code>List&lt;T&gt;</code></td>
<td><code>stream.toList()</code> (Java 16) is shorter and already unmodifiable</td>
</tr>
<tr>
<td><code>toSet()</code></td>
<td><code>Set&lt;T&gt;</code></td>
<td>dedupes via <code>equals</code>/<code>hashCode</code></td>
</tr>
<tr>
<td><code>toCollection(TreeSet::new)</code></td>
<td>your choice</td>
<td>when you need a specific implementation</td>
</tr>
<tr>
<td><code>toMap(k, v)</code></td>
<td><code>Map&lt;K,V&gt;</code></td>
<td><strong>throws</strong> on duplicate keys, <strong>NPEs</strong> on null values</td>
</tr>
<tr>
<td><code>toMap(k, v, merge)</code></td>
<td><code>Map&lt;K,V&gt;</code></td>
<td>supply <code>(a,b) -&gt; a</code> to keep the first</td>
</tr>
<tr>
<td><code>toMap(k, v, merge, LinkedHashMap::new)</code></td>
<td>ordered map</td>
<td>preserves encounter order</td>
</tr>
<tr>
<td><code>counting()</code></td>
<td><code>Long</code></td>
<td></td>
</tr>
<tr>
<td><code>summingInt/Long/Double</code></td>
<td>number</td>
<td></td>
</tr>
<tr>
<td><code>averagingInt/Long/Double</code></td>
<td><code>Double</code></td>
<td>returns <code>0.0</code> on empty, not <code>Optional</code></td>
</tr>
<tr>
<td><code>minBy(cmp)</code> / <code>maxBy(cmp)</code></td>
<td><code>Optional&lt;T&gt;</code></td>
<td></td>
</tr>
<tr>
<td><code>summarizingInt(...)</code></td>
<td><code>IntSummaryStatistics</code></td>
<td>count, sum, min, max, average in one pass</td>
</tr>
<tr>
<td><code>joining(", ", "[", "]")</code></td>
<td><code>String</code></td>
<td>delimiter, prefix, suffix</td>
</tr>
<tr>
<td><code>mapping(fn, downstream)</code></td>
<td>transformed</td>
<td>apply before collecting</td>
</tr>
<tr>
<td><code>filtering(pred, downstream)</code></td>
<td>filtered</td>
<td>Java 9 — keeps empty groups, unlike <code>filter</code> before <code>groupingBy</code></td>
</tr>
<tr>
<td><code>flatMapping(fn, downstream)</code></td>
<td>flattened</td>
<td>Java 9 — for one-to-many inside a group</td>
</tr>
<tr>
<td><code>collectingAndThen(c, finisher)</code></td>
<td>anything</td>
<td>unwrap an <code>Optional</code>, make immutable</td>
</tr>
<tr>
<td><code>reducing(identity, op)</code></td>
<td><code>T</code></td>
<td>prefer <code>reduce()</code> unless it's a downstream</td>
</tr>
<tr>
<td><code>teeing(c1, c2, merger)</code></td>
<td>merged</td>
<td>Java 12 — two collectors, one pass</td>
</tr>
</tbody>
</table>
<div class="hl"><pre><span></span><code><span class="c1">// summary stats in a single pass — beats three separate streams</span>
<span class="n">IntSummaryStatistics</span><span class="w"> </span><span class="n">stats</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">summarizingInt</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">age</span><span class="p">));</span>
<span class="n">stats</span><span class="p">.</span><span class="na">getCount</span><span class="p">();</span><span class="w"> </span><span class="n">stats</span><span class="p">.</span><span class="na">getMin</span><span class="p">();</span><span class="w"> </span><span class="n">stats</span><span class="p">.</span><span class="na">getMax</span><span class="p">();</span><span class="w"> </span><span class="n">stats</span><span class="p">.</span><span class="na">getAverage</span><span class="p">();</span><span class="w"> </span><span class="n">stats</span><span class="p">.</span><span class="na">getSum</span><span class="p">();</span>

<span class="c1">// min and max together, one traversal</span>
<span class="kd">record</span> <span class="nc">Range</span><span class="p">(</span><span class="n">Employee</span><span class="w"> </span><span class="n">cheapest</span><span class="p">,</span><span class="w"> </span><span class="n">Employee</span><span class="w"> </span><span class="n">dearest</span><span class="p">)</span><span class="w"> </span><span class="p">{}</span>
<span class="n">Range</span><span class="w"> </span><span class="n">r</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">().</span><span class="na">collect</span><span class="p">(</span><span class="n">teeing</span><span class="p">(</span>
<span class="w">        </span><span class="n">minBy</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">)),</span>
<span class="w">        </span><span class="n">maxBy</span><span class="p">(</span><span class="n">comparing</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">salary</span><span class="p">)),</span>
<span class="w">        </span><span class="p">(</span><span class="n">lo</span><span class="p">,</span><span class="w"> </span><span class="n">hi</span><span class="p">)</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="k">new</span><span class="w"> </span><span class="n">Range</span><span class="p">(</span><span class="n">lo</span><span class="p">.</span><span class="na">orElseThrow</span><span class="p">(),</span><span class="w"> </span><span class="n">hi</span><span class="p">.</span><span class="na">orElseThrow</span><span class="p">())));</span>

<span class="c1">// filtering vs filter — the difference is empty groups</span>
<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">List</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">a</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">()</span>
<span class="w">    </span><span class="p">.</span><span class="na">filter</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">salary</span><span class="p">().</span><span class="na">compareTo</span><span class="p">(</span><span class="n">HIGH</span><span class="p">)</span><span class="w"> </span><span class="o">&gt;</span><span class="w"> </span><span class="mi">0</span><span class="p">)</span>
<span class="w">    </span><span class="p">.</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">));</span><span class="w">            </span><span class="c1">// HR disappears entirely</span>

<span class="n">Map</span><span class="o">&lt;</span><span class="n">String</span><span class="p">,</span><span class="w"> </span><span class="n">List</span><span class="o">&lt;</span><span class="n">Employee</span><span class="o">&gt;&gt;</span><span class="w"> </span><span class="n">b</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">emps</span><span class="p">.</span><span class="na">stream</span><span class="p">()</span>
<span class="w">    </span><span class="p">.</span><span class="na">collect</span><span class="p">(</span><span class="n">groupingBy</span><span class="p">(</span><span class="n">Employee</span><span class="p">::</span><span class="n">dept</span><span class="p">,</span>
<span class="w">             </span><span class="n">filtering</span><span class="p">(</span><span class="n">e</span><span class="w"> </span><span class="o">-&gt;</span><span class="w"> </span><span class="n">e</span><span class="p">.</span><span class="na">salary</span><span class="p">().</span><span class="na">compareTo</span><span class="p">(</span><span class="n">HIGH</span><span class="p">)</span><span class="w"> </span><span class="o">&gt;</span><span class="w"> </span><span class="mi">0</span><span class="p">,</span><span class="w"> </span><span class="n">toList</span><span class="p">())));</span><span class="w">  </span><span class="c1">// HR=[] survives</span>
</code></pre></div>
