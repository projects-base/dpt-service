<!doctype html>
<html lang="en" data-theme="focus" data-scale="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="dark light">
<meta name="theme-color" content="#0F1317">
<title>Interview Prep — Java Backend &amp; Full Stack</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
/* ============================================================================
   Three palettes, because the right one depends on when you're reading.

   FOCUS (default) — cool and high-contrast. Short-wavelength light near 480nm
     drives the melanopsin pathway that raises alertness, so this palette leans
     into azure and teal deliberately: it is built to keep you sharp.
   PAPER — the same logic for daylight, crisp and bright.
   EMBER — warm, and stripped of that 480nm band entirely, for the last hour
     before sleep when you want to wind down instead of stay up.

   In every palette AZURE/AMBER marks the question, TEAL/SAGE marks the answer.
   ========================================================================== */
:root[data-theme="focus"]{
  --bg:#0F1317; --surface:#161C22; --surface-2:#1D242B;
  --text:#E1E8EE; --text-2:#B5C1CB; --muted:#7B8996;
  --rule:#232C34; --rule-2:#34414B;
  --q:#54A9E0; --q-dim:#2E6E96; --q-soft:#122330; --q-ink:#DEEEFA;
  --a:#4FBBA0; --a-dim:#2F7C69; --warn:#E0925A; --warn-soft:#2A1D14;
  --code-bg:#0A0E11; --code-fg:#CFD8E0; --code-rule:#1E262D;
  --chip-fg:#0F1317; --marker:rgba(84,169,224,.30);
  --sx-key:#7FB8EA; --sx-str:#95C98C; --sx-com:#5D6C78; --sx-fn:#C6A8E2;
  --sx-cls:#E2CB8B; --sx-num:#E29D6D; --sx-op:#8FA0AC; --sx-bi:#71C2C2;
}
:root[data-theme="paper"]{
  --bg:#F4F7F9; --surface:#FFFFFF; --surface-2:#E9EEF2;
  --text:#0F171D; --text-2:#33424D; --muted:#66757F;
  --rule:#DDE4E9; --rule-2:#C4CFD7;
  --q:#0B6CA8; --q-dim:#4494C6; --q-soft:#E5F0F8; --q-ink:#0A2E45;
  --a:#0E7A64; --a-dim:#54AC98; --warn:#A5561B; --warn-soft:#F7E9DA;
  --code-bg:#12181D; --code-fg:#D3DBE2; --code-rule:#222B32;
  --chip-fg:#FFFFFF; --marker:rgba(11,108,168,.22);
  --sx-key:#7FB8EA; --sx-str:#95C98C; --sx-com:#5D6C78; --sx-fn:#C6A8E2;
  --sx-cls:#E2CB8B; --sx-num:#E29D6D; --sx-op:#8FA0AC; --sx-bi:#71C2C2;
}
:root[data-theme="ember"]{
  --bg:#16120E; --surface:#1E1913; --surface-2:#251E17;
  --text:#E9DDCA; --text-2:#C6B69E; --muted:#8F8069;
  --rule:#2C251E; --rule-2:#40362A;
  --q:#DB9C46; --q-dim:#9E6E2C; --q-soft:#241A10; --q-ink:#F4E3C6;
  --a:#94A26D; --a-dim:#6B7650; --warn:#C97A4A; --warn-soft:#2A1B12;
  --code-bg:#100D0A; --code-fg:#DACCB6; --code-rule:#2A231B;
  --chip-fg:#16120E; --marker:rgba(219,156,70,.28);
  --sx-key:#E0A05C; --sx-str:#A9B37E; --sx-com:#7B6B55; --sx-fn:#E5C79A;
  --sx-cls:#D4B37C; --sx-num:#CD8763; --sx-op:#93836D; --sx-bi:#D9AE7B;
}
:root{
  --sans:"IBM Plex Sans Condensed",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --serif:"IBM Plex Serif",Georgia,"Times New Roman",serif;
  --mono:"IBM Plex Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  --base:17px; --lh:1.76; --rail:312px; --measure:75ch;
}
:root[data-scale="0"]{--base:15.5px}
:root[data-scale="2"]{--base:18.5px;--lh:1.8}
:root[data-scale="3"]{--base:20px;--lh:1.84}

*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:100px;background:var(--bg);-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto} *{animation-duration:.001ms!important;transition-duration:.001ms!important}
}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--serif);
  font-size:var(--base);line-height:var(--lh);-webkit-font-smoothing:antialiased;
  transition:background-color .35s ease,color .35s ease}
::selection{background:var(--marker);color:var(--text)}

/* ------------------------------------------------------------------ chrome */
.progress{position:fixed;top:0;left:0;height:2px;width:0;background:var(--q);
  z-index:60;opacity:.9;transition:width .1s linear}
.masthead{position:sticky;top:0;z-index:45;background:var(--bg);
  border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:14px;
  padding:11px 20px;padding-top:max(11px,env(safe-area-inset-top))}
.brand{display:flex;align-items:baseline;gap:11px;min-width:0}
.brand b{font-family:var(--sans);font-weight:700;font-size:16px;white-space:nowrap}
.brand span{font-family:var(--mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;
  color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tools{margin-left:auto;display:flex;align-items:center;gap:8px}
.search-wrap{position:relative;display:flex;align-items:center}
#search{font-family:var(--mono);font-size:13px;padding:8px 32px 8px 11px;width:210px;
  background:var(--surface);border:1px solid var(--rule-2);border-radius:4px;color:var(--text)}
#search:focus{outline:2px solid var(--q);outline-offset:1px;border-color:transparent}
#search::placeholder{color:var(--muted)}
.slash{position:absolute;right:9px;font-family:var(--mono);font-size:10px;color:var(--muted);
  border:1px solid var(--rule-2);border-radius:3px;padding:1px 4px;pointer-events:none}
#search:focus+.slash{opacity:0}
.tool{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);background:var(--surface);border:1px solid var(--rule-2);border-radius:4px;
  padding:7px 10px;cursor:pointer;line-height:1;transition:color .2s,border-color .2s,background-color .2s}
.tool:hover{color:var(--text);border-color:var(--q-dim)}
.tool[aria-pressed="true"]{color:var(--q);border-color:var(--q-dim);background:var(--q-soft)}
.tool:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--q);outline-offset:2px}
.sizer{display:flex;border:1px solid var(--rule-2);border-radius:4px;overflow:hidden;background:var(--surface)}
.sizer button{font-family:var(--mono);font-size:12px;color:var(--muted);background:none;border:0;
  padding:6px 10px;cursor:pointer}
.sizer button:hover{color:var(--q);background:var(--q-soft)}
.sizer button+button{border-left:1px solid var(--rule-2)}
.count{font-family:var(--mono);font-size:11px;color:var(--muted);white-space:nowrap}
#menuBtn{display:none}

/* --------------------------------------------- rail: the whole book at once */
.shell{display:grid;grid-template-columns:var(--rail) minmax(0,1fr);align-items:start}
.rail{position:sticky;top:54px;height:calc(100vh - 54px);overflow-y:auto;
  border-right:1px solid var(--rule);padding:18px 0 80px;background:var(--bg);
  scrollbar-width:thin;scrollbar-color:var(--rule-2) transparent}
.rail::-webkit-scrollbar{width:9px}
.rail::-webkit-scrollbar-thumb{background:var(--rule-2);border-radius:5px}
.rail-head{padding:0 18px 14px;border-bottom:1px solid var(--rule);margin-bottom:8px}
.rail-label{font-family:var(--mono);font-size:10px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--muted);margin:0}
.rail-sub{font-family:var(--sans);font-size:12.5px;color:var(--muted);margin:5px 0 0}

.grp{border-left:2px solid transparent}
.grp-row{display:grid;grid-template-columns:26px 1fr auto;column-gap:11px;align-items:start;
  width:100%;text-align:left;background:none;border:0;padding:11px 16px;cursor:pointer;
  color:var(--text-2);font:inherit;transition:background-color .18s,color .18s}
.grp-row:hover{background:var(--surface);color:var(--text)}
.grp-n{font-family:var(--mono);font-size:11px;color:var(--muted);font-weight:500;padding-top:2px}
.grp-body{display:flex;flex-direction:column;gap:2px;min-width:0}
.grp-t{font-family:var(--sans);font-weight:600;font-size:15px;line-height:1.26}
.grp-k{font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:.03em}
.grp-c{font-family:var(--mono);font-size:10.5px;color:var(--muted);padding-top:3px}
.grp.is-open{border-left-color:var(--q);background:var(--surface)}
.grp.is-open .grp-row{color:var(--text)}
.grp.is-open .grp-n,.grp.is-open .grp-c{color:var(--q)}
.grp.is-open .grp-t{background:linear-gradient(var(--marker),var(--marker)) left 66% / 100% 38% no-repeat;
  box-decoration-break:clone;padding:0 3px;margin:0 -3px}
.grp-secs{display:none;padding:2px 0 12px}
.grp.is-open .grp-secs{display:block}
.sec{display:block;font-family:var(--sans);font-size:13px;line-height:1.4;color:var(--muted);
  text-decoration:none;padding:6px 16px 6px 53px;border-left:2px solid transparent;margin-left:-2px;
  transition:color .16s,background-color .16s}
.sec.lvl3{padding-left:66px;font-size:12.5px;opacity:.85}
.sec:hover{color:var(--text);background:var(--surface-2)}
.sec.here{color:var(--q);border-left-color:var(--q);font-weight:600;opacity:1}
.scrim{display:none}

/* ------------------------------------------------------------------- prose */
main{padding:0 0 40vh;min-width:0}
.panel{max-width:var(--measure);padding:44px 52px 0}
.part-head{border-bottom:1px solid var(--rule-2);padding-bottom:18px;margin-bottom:34px}
.part-n{font-family:var(--mono);font-size:11px;letter-spacing:.22em;color:var(--q);
  display:block;margin-bottom:8px;text-transform:uppercase}
.part-head h1{font-family:var(--sans);font-weight:700;font-size:clamp(26px,3.6vw,38px);
  line-height:1.06;letter-spacing:-.015em;margin:0}
.kicker{font-family:var(--mono);font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);margin:9px 0 0}
.kicker .dot{color:var(--rule-2)}

.prose h2{font-family:var(--sans);font-weight:700;font-size:1.4em;letter-spacing:-.012em;
  margin:60px 0 18px;padding-top:22px;border-top:1px solid var(--rule);line-height:1.16;color:var(--text)}
.prose h3{font-family:var(--sans);font-weight:600;font-size:1.12em;margin:40px 0 12px}
.prose h4{font-family:var(--sans);font-weight:600;font-size:.96em;margin:26px 0 8px}
.prose>h2:first-child{border-top:0;margin-top:0;padding-top:0}
.anchor{font-family:var(--mono);font-size:.58em;color:var(--rule-2);text-decoration:none;
  margin-left:9px;opacity:0;transition:opacity .14s}
h2:hover .anchor,h3:hover .anchor{opacity:1}
.anchor:hover{color:var(--q)}

.prose p{margin:0 0 15px}
.prose ul,.prose ol{margin:0 0 17px;padding-left:22px}
.prose li{margin-bottom:8px}
.prose hr{border:0;border-top:1px solid var(--rule);margin:48px 0}
.prose a{color:var(--q)}
.prose strong{font-weight:600;color:var(--text)}
.prose em{font-style:italic;color:var(--text-2)}
.prose>ul li::marker,.prose>ol li::marker{color:var(--q-dim)}

/* ---------------------------------------------- question / answer pairing */
.qa{margin:30px 0 34px;border-radius:5px;overflow:hidden;background:var(--surface);
  border:1px solid var(--rule)}
.qa .q{margin:0;padding:14px 18px 13px;background:var(--q-soft);
  border-left:3px solid var(--q);display:flex;gap:11px;align-items:baseline}
.qnum{font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.06em;
  color:var(--chip-fg);background:var(--q);padding:3px 6px 2px;border-radius:3px;
  white-space:nowrap;flex:0 0 auto;position:relative;top:-1px}
.qtext{font-family:var(--sans);font-weight:700;font-size:1.06em;line-height:1.36;
  letter-spacing:-.005em;color:var(--q-ink)}
.qa .a{padding:16px 18px 4px;border-left:3px solid var(--a-dim);color:var(--text-2)}
.qa .a>*:last-child{margin-bottom:14px}
.qa .a strong{color:var(--text)}
.qa .a li::marker{color:var(--a)}
.qa .a>ul,.qa .a>ol{padding-left:20px}
.qa:hover .a{border-left-color:var(--a)}

blockquote{margin:0 0 32px;padding:16px 20px;background:var(--surface);
  border-left:3px solid var(--q-dim);font-size:.94em;color:var(--text-2);border-radius:0 4px 4px 0}
blockquote p{margin:0 0 9px}
blockquote p:last-child{margin:0}
blockquote strong{color:var(--text)}

code{font-family:var(--mono);font-size:.845em;background:var(--surface-2);
  padding:2px 5px;border-radius:3px;border:1px solid var(--rule);color:var(--text)}
pre{background:var(--code-bg);color:var(--code-fg);padding:16px 18px;border-radius:4px;
  border:1px solid var(--code-rule);overflow-x:auto;margin:0 0 20px;
  font-size:.78em;line-height:1.62;position:relative;
  scrollbar-width:thin;scrollbar-color:var(--rule-2) transparent}
pre code{background:none;border:0;padding:0;color:inherit;font-size:inherit;white-space:pre}
pre::-webkit-scrollbar{height:9px}
pre::-webkit-scrollbar-thumb{background:var(--rule-2);border-radius:5px}
.copy{position:absolute;top:8px;right:8px;font-family:var(--mono);font-size:10px;
  letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:var(--surface-2);
  border:1px solid var(--rule-2);border-radius:3px;padding:4px 8px;cursor:pointer;
  opacity:0;transition:opacity .14s,color .14s}
pre:hover .copy,.copy:focus{opacity:1}
.copy:hover{color:var(--q)}

/* syntax colours follow the active palette */
.hl .k,.hl .kd,.hl .kn,.hl .kc,.hl .kt{color:var(--sx-key)}
.hl .s,.hl .s1,.hl .s2,.hl .sb,.hl .se,.hl .ss,.hl .sr{color:var(--sx-str)}
.hl .c,.hl .c1,.hl .cm,.hl .cs{color:var(--sx-com);font-style:italic}
.hl .nf,.hl .fm{color:var(--sx-fn)}
.hl .nc,.hl .nn,.hl .nl,.hl .nt{color:var(--sx-cls)}
.hl .mi,.hl .mf,.hl .il,.hl .m{color:var(--sx-num)}
.hl .nd{color:var(--sx-fn)}
.hl .o,.hl .p{color:var(--sx-op)}
.hl .nb,.hl .bp{color:var(--sx-bi)}
.hl .n,.hl .nx,.hl .nv,.hl .na,.hl .py,.hl .w,.hl .err{color:inherit;background:none}

table{width:100%;border-collapse:collapse;margin:0 0 22px;font-size:.86em;
  font-family:var(--sans);display:block;overflow-x:auto}
th{font-weight:600;text-align:left;border-bottom:1px solid var(--a-dim);padding:9px 12px 8px;
  font-size:.82em;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;color:var(--text)}
td{border-bottom:1px solid var(--rule);padding:9px 12px;vertical-align:top;color:var(--text-2)}
tr:hover td{background:var(--surface-2)}
td code{font-size:.9em;white-space:nowrap}

.prose li input[type=checkbox]{margin-right:9px;accent-color:var(--q);width:16px;height:16px}
mark{background:var(--marker);color:var(--text);padding:0 3px;border-radius:2px}



/* ------------------------------------------------------- answer callouts */
.qa .a > .tldr{background:var(--q-soft);border-left:2px solid var(--q-dim);
  padding:10px 13px;border-radius:0 3px 3px 0;margin:0 0 14px;color:var(--text)}
.qa .a > .tldr strong{font-family:var(--sans);font-size:.82em;letter-spacing:.09em;
  text-transform:uppercase;color:var(--q)}
.qa .a > .gotcha{background:var(--warn-soft);border-left:2px solid var(--warn);
  padding:10px 13px;border-radius:0 3px 3px 0;margin:14px 0 4px}
.qa .a > .gotcha strong{font-family:var(--sans);font-size:.82em;letter-spacing:.09em;
  text-transform:uppercase;color:var(--warn)}
.qa .a > .bonus{border-left:2px solid var(--a);padding:10px 13px;margin:14px 0 4px;
  background:var(--surface-2);border-radius:0 3px 3px 0}
.qa .a > .bonus strong{font-family:var(--sans);font-size:.82em;letter-spacing:.09em;
  text-transform:uppercase;color:var(--a)}
.qa .a > ul{margin-bottom:14px}
.qa .a > ul > li{margin-bottom:7px}
@media (max-width:640px){
  .qa .a > .tldr,.qa .a > .gotcha,.qa .a > .bonus{padding:9px 11px}
}

/* ------------------------------------------------------------- figures */
.fig-wrap{margin:26px 0 30px;padding:18px 18px 12px;background:var(--surface);
  border:1px solid var(--rule);border-radius:5px}
.qa .a .fig-wrap{margin-left:0;margin-right:0;background:var(--bg)}
.fig{display:block;width:100%;height:auto;max-width:100%;overflow:visible}
.fig .box{fill:var(--surface-2);stroke:var(--rule-2);stroke-width:1}
.fig .qbox{fill:var(--q-soft);stroke:var(--q);stroke-width:1.2}
.fig .abox{fill:none;stroke:var(--a-dim);stroke-width:1.2}
.fig .leaf rect{fill:var(--surface-2);stroke:var(--rule-2);stroke-width:1}
.fig .qbox-g rect{fill:var(--q-soft);stroke:var(--q);stroke-width:1.2}
.fig .abox-g rect{fill:none;stroke:var(--a-dim);stroke-width:1.2}
.fig .ln{stroke:var(--rule-2);stroke-width:1.3;fill:none}
.fig .fill-ln{fill:var(--rule-2)}
.fig text{font-family:var(--sans);font-size:13px;fill:var(--text)}
.fig .t{font-weight:600;font-size:13.5px}
.fig .st{font-size:11.5px;fill:var(--muted);font-family:var(--sans)}
.fig .m,.fig .mono{font-family:var(--mono);font-size:11.5px;fill:var(--text-2)}
.fig .ctr{text-anchor:middle}
.fig .venn-a{fill:var(--q);fill-opacity:.30;stroke:var(--q);stroke-width:1.3}
.fig .venn-o{fill:none;stroke:var(--rule-2);stroke-width:1.3}
.fig .venn-fill{fill:var(--q);fill-opacity:.42;stroke:var(--q);stroke-width:1.3}
figcaption{font-family:var(--sans);font-size:12.5px;color:var(--muted);
  line-height:1.5;margin-top:12px;padding-top:11px;border-top:1px solid var(--rule)}
figcaption code{font-size:.92em;white-space:normal}
@media (max-width:640px){
  .fig-wrap{padding:12px 10px 10px;margin-left:-3px;margin-right:-3px}
  .fig text{font-size:14px} .fig .st{font-size:12.5px} .fig .m{font-size:12.5px}
}

/* -------------------------------------------------------------- focus mode */
body.focus .rail{display:none}
body.focus .shell{grid-template-columns:minmax(0,1fr)}
body.focus .panel,body.focus .results{max-width:68ch;margin:0 auto}
body.focus .prose>*{transition:opacity .45s ease}
body.focus .prose>.dim{opacity:.3}
@media (prefers-reduced-motion:reduce){body.focus .prose>.dim{opacity:.42}}

/* ------------------------------------------------------------ search panel */
.results{max-width:var(--measure);padding:40px 52px}
.results h2{font-family:var(--sans);font-size:1.2em;margin:0 0 5px;font-weight:700}
.results .lead{font-family:var(--mono);font-size:11.5px;color:var(--muted);
  letter-spacing:.07em;text-transform:uppercase;margin:0 0 24px}
.hit{display:block;text-decoration:none;color:inherit;border:1px solid var(--rule);
  border-left:3px solid var(--rule-2);padding:13px 15px;margin:0 0 9px;border-radius:4px;
  background:var(--surface);transition:border-color .16s,background-color .16s}
.hit:hover{border-left-color:var(--q);background:var(--surface-2)}
.hit-meta{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--q);margin-bottom:5px}
.hit-t{font-family:var(--sans);font-weight:600;font-size:1em;line-height:1.32;margin-bottom:4px}
.hit-x{font-size:.87em;color:var(--muted);line-height:1.55}
.empty{font-family:var(--sans);color:var(--muted);padding:22px 0}

/* ------------------------------------------------------------------ mobile */
@media (max-width:1040px){
  :root{--measure:100%}
  .shell{grid-template-columns:1fr}
  #menuBtn{display:inline-block}
  .rail{position:fixed;top:0;left:0;bottom:0;width:min(86vw,330px);height:100%;z-index:55;
    transform:translateX(-101%);transition:transform .28s ease;
    padding-top:max(18px,env(safe-area-inset-top));border-right:1px solid var(--rule-2)}
  .rail.open{transform:translateX(0)}
  .scrim{display:block;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:50;
    opacity:0;pointer-events:none;transition:opacity .28s}
  .scrim.open{opacity:1;pointer-events:auto}
  .panel,.results{padding:26px 20px 0}
  .brand span,.tool-label{display:none}
  #search{width:130px}
  body.focus .rail{display:block}
  body.focus .panel,body.focus .results{max-width:100%}
}
@media (max-width:640px){
  :root{--base:16.5px;--lh:1.72}
  .tools{gap:6px}
  .sizer{display:none}
  .masthead{padding:9px 14px;gap:10px}
