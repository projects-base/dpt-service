<span class="w">  </span><span class="nt">profiles</span><span class="p">:</span>
<span class="w">    </span><span class="nt">active</span><span class="p">:</span><span class="w"> </span><span class="l l-Scalar l-Scalar-Plain">${ACTIVE_PROFILE:local}</span>

<span class="w">  </span><span class="nt">datasource</span><span class="p">:</span>
