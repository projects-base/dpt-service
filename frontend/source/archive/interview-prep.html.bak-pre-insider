    themeBtn.querySelector('.tool-label').textContent=t.label;
    themeBtn.title='Switch to '+t.next+' (T)';
    var tc=document.querySelector('meta[name=theme-color]');
    if(tc) tc.setAttribute('content',t.bg);
  }
  function applyScale(){ root.setAttribute('data-scale',String(prefs.scale)); }
  function applyFocus(){
    document.body.classList.toggle('focus',prefs.focus);
    focusBtn.setAttribute('aria-pressed',String(prefs.focus));
    if(prefs.focus) startDim(); else stopDim();
  }
  themeBtn.addEventListener('click',function(){
    prefs.theme=THEMES[(themeIndex()+1)%THEMES.length].id; applyTheme(); savePrefs();
  });
  focusBtn.addEventListener('click',function(){prefs.focus=!prefs.focus;applyFocus();savePrefs();});
  document.getElementById('bigger').addEventListener('click',function(){prefs.scale=Math.min(3,prefs.scale+1);applyScale();savePrefs();});
  document.getElementById('smaller').addEventListener('click',function(){prefs.scale=Math.max(0,prefs.scale-1);applyScale();savePrefs();});

  function drawer(open){
    rail.classList.toggle('open',open);
    scrim.classList.toggle('open',open);
    menuBtn.setAttribute('aria-expanded',String(open));
    document.body.style.overflow=(open&&innerWidth<=1040)?'hidden':'';
  }
  menuBtn.addEventListener('click',function(){drawer(!rail.classList.contains('open'));});
  scrim.addEventListener('click',function(){drawer(false);});

  var dimObserver=null;
  function startDim(){
    stopDim();
    var prose=document.querySelector('.panel:not([hidden]) .prose');
    if(!prose||!window.IntersectionObserver) return;
    dimObserver=new IntersectionObserver(function(es){
      es.forEach(function(e){ e.target.classList.toggle('dim',!e.isIntersecting); });
    },{rootMargin:'-22% 0px -32% 0px',threshold:0});
    [].slice.call(prose.children).forEach(function(el){el.classList.add('dim');dimObserver.observe(el);});
  }
  function stopDim(){
    if(dimObserver){dimObserver.disconnect();dimObserver=null;}
    [].slice.call(document.querySelectorAll('.prose>.dim')).forEach(function(el){el.classList.remove('dim');});
  }

  [].slice.call(document.querySelectorAll('pre')).forEach(function(pre){
    var b=document.createElement('button');
    b.className='copy'; b.type='button'; b.textContent='Copy';
    b.addEventListener('click',function(){
      var c=pre.querySelector('code');
      navigator.clipboard.writeText(c?c.innerText:pre.innerText).then(function(){
        b.textContent='Copied'; setTimeout(function(){b.textContent='Copy';},1400);
      }).catch(function(){
        b.textContent='Press \u2318C'; setTimeout(function(){b.textContent='Copy';},1600);
      });
    });
    pre.appendChild(b);
  });

  [].slice.call(document.querySelectorAll('.prose li')).forEach(function(li){
    var f=li.firstChild;
    if(f&&f.nodeType===3&&/^\s*\[\s?\]\s/.test(f.nodeValue)){
      f.nodeValue=f.nodeValue.replace(/^\s*\[\s?\]\s/,'');
      var cb=document.createElement('input'); cb.type='checkbox';
      li.style.listStyle='none'; li.style.marginLeft='-20px';
      li.insertBefore(cb,li.firstChild);
    }
  });

  function show(n,scroll){
    current=n;
    groups.forEach(function(g,i){
      var on=i===n-1;
      g.classList.toggle('is-open',on);
      var row=g.querySelector('.grp-row');
      row.setAttribute('aria-selected',on?'true':'false');
      row.setAttribute('aria-expanded',on?'true':'false');
    });
    panels.forEach(function(p,i){p.hidden=i!==n-1;});
    results.hidden=true;
    [].slice.call(document.querySelectorAll('.sec.here'))
      .forEach(function(l){l.classList.remove('here');});
    if(scroll!==false) toTop();
    if(prefs.focus) startDim();
    spy(); progress();
  }

  rows.forEach(function(r){
    r.addEventListener('click',function(){
      search.value=''; count.textContent='';
      show(+r.dataset.part);
      if(innerWidth<=1040) drawer(false);
    });
  });
  rows.forEach(function(r,i){
    r.addEventListener('keydown',function(e){
      var d=e.key==='ArrowDown'?1:e.key==='ArrowUp'?-1:0;
      if(!d) return; e.preventDefault();
      var nx=rows[(i+d+rows.length)%rows.length]; nx.focus(); nx.click();
    });
  });

  [].slice.call(document.querySelectorAll('.sec')).forEach(function(a){
    a.addEventListener('click',function(e){
      e.preventDefault();
      var p=+a.dataset.part;
      if(innerWidth<=1040) drawer(false);      // body overflow must be released first
      if(p!==current||!results.hidden) show(p,false);
      var id=a.dataset.id;
      requestAnimationFrame(function(){ goTo(document.getElementById(id),true); });
    });
  });

  document.addEventListener('click',function(e){
    var a=e.target.closest('a.anchor'); if(!a) return;
    e.preventDefault();
    goTo(document.getElementById(a.getAttribute('href').slice(1)),true);
  });

  function spy(){
    var links=[].slice.call(document.querySelectorAll('.grp.is-open .sec'));
    if(!links.length) return;
    var active=links[0];
    for(var i=0;i<links.length;i++){
      var el=document.getElementById(links[i].dataset.id);
      if(el&&el.getBoundingClientRect().top<155) active=links[i]; else break;
    }
    links.forEach(function(l){l.classList.toggle('here',l===active);});
    if(innerWidth>1040){
      var box=rail.getBoundingClientRect(), a=active.getBoundingClientRect();
      if(a.top<box.top+40||a.bottom>box.bottom-20) active.scrollIntoView({block:'nearest'});
    }
  }
  function progress(){
    var h=document.documentElement.scrollHeight-innerHeight;
    bar.style.width=(h>0?Math.min(100,(window.scrollY/h)*100):0)+'%';
  }
  var ticking=false;
  addEventListener('scroll',function(){
    if(ticking) return; ticking=true;
    requestAnimationFrame(function(){progress(); if(results.hidden) spy(); ticking=false;});
  },{passive:true});
  addEventListener('resize',progress,{passive:true});

  var index=[];
  panels.forEach(function(panel,pi){
    [].slice.call(panel.querySelectorAll('h2,h3')).forEach(function(h){
      var nx=h.nextElementSibling;
      index.push({part:pi+1,id:h.id,title:h.textContent.replace(/#$/,'').trim(),
                  text:(nx?nx.textContent:'').slice(0,240),kind:'Section'});
    });
    [].slice.call(panel.querySelectorAll('section.qa')).forEach(function(qa){
      var num=qa.querySelector('.qnum'), t=qa.querySelector('.qtext'), a=qa.querySelector('.a');
      index.push({part:pi+1,id:qa.id,
                  title:(num?num.textContent:'')+'. '+(t?t.textContent:''),
                  text:(a?a.textContent:'').trim().slice(0,260),kind:'Question'});
    });
  });
  function esc(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
  function hl(s,q){return s.replace(new RegExp('('+esc(q)+')','ig'),'<mark>$1</mark>');}

  function runSearch(q){
    q=q.trim();
    if(q.length<2){count.textContent='';show(current,false);return;}
    var needle=q.toLowerCase();
    var hits=index.filter(function(r){return (r.title+' '+r.text).toLowerCase().indexOf(needle)>-1;}).slice(0,60);
    panels.forEach(function(p){p.hidden=true;}); stopDim(); results.hidden=false;
    count.textContent=hits.length+' match'+(hits.length===1?'':'es');
    var names=rows.map(function(r){return r.querySelector('.grp-t').textContent;});
    results.innerHTML='<h2>Results for \u201C'+q.replace(/</g,'&lt;')+'\u201D</h2>'+
      '<p class="lead">'+hits.length+' match'+(hits.length===1?'':'es')+' across twelve parts</p>'+
      (hits.length?hits.map(function(h){
        return '<a class="hit" href="#'+h.id+'" data-part="'+h.part+'" data-id="'+h.id+'">'+
          '<div class="hit-meta">Part '+String(h.part<10?'0'+h.part:h.part)+' \u00B7 '+names[h.part-1]+' \u00B7 '+h.kind+'</div>'+
          '<div class="hit-t">'+hl(h.title.replace(/</g,'&lt;'),q)+'</div>'+
          '<div class="hit-x">'+hl(h.text.replace(/</g,'&lt;'),q)+'\u2026</div></a>';
      }).join(''):'<p class="empty">Nothing matched. Try a shorter term \u2014 \u201Cvolatile\u201D, \u201CN+1\u201D, \u201Csaga\u201D, \u201Cerasure\u201D, \u201CCSRF\u201D.</p>');
    window.scrollTo(0,0); progress();
  }
  results.addEventListener('click',function(e){
    var a=e.target.closest('.hit'); if(!a) return;
    e.preventDefault(); search.value=''; count.textContent='';
    show(+a.dataset.part,false);
    var id=a.dataset.id;
    requestAnimationFrame(function(){ goTo(document.getElementById(id),false); });
  });
  var timer;
  search.addEventListener('input',function(){clearTimeout(timer);timer=setTimeout(function(){runSearch(search.value);},140);});
  search.addEventListener('keydown',function(e){
    if(e.key==='Escape'){search.value='';count.textContent='';show(current,false);search.blur();}
  });

  document.addEventListener('keydown',function(e){
    if(e.metaKey||e.ctrlKey||e.altKey) return;
    if(/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) return;
    if(e.key==='/'){e.preventDefault();search.focus();return;}
    if(e.key==='Escape'&&rail.classList.contains('open')){drawer(false);return;}
    if(e.key==='t'||e.key==='T'){themeBtn.click();return;}
    if(e.key==='f'||e.key==='F'){focusBtn.click();return;}
    var kmap={'0':10,'-':11,'=':12};
    if(/^[1-9]$/.test(e.key)||kmap[e.key]){search.value='';count.textContent='';
      show(kmap[e.key]||+e.key);}
  });

  loadPrefs().then(function(){
    applyTheme(); applyScale(); applyFocus();
    var m=/^#(?:p(\d{1,2})-|q(\d{1,2})-)/.exec(location.hash);
    if(m){
      show(+(m[1]||m[2]),false);
      var el=document.getElementById(location.hash.slice(1));
      if(el) setTimeout(function(){ goTo(el,false); },80);
    } else show(1);
    progress();
  });
})();
</script>
</body>
</html>
